            "58125/udp"
          ],
          "files": [],
          "host_cgroup_namespace": false
        },
        "description": "Verifies ADP writes to the platform-default Linux log file path (/var/log/datadog/agent-data-plane.log) when no override is provided",
        "env": {
          "DD_API_KEY": "00000000000000000000000000000000",
          "DD_DATA_PLANE_DOGSTATSD_ENABLED": "true",
          "DD_DATA_PLANE_ENABLED": "true",
          "DD_DATA_PLANE_USE_NEW_CONFIG_STREAM_ENDPOINT": "true",
          "DD_HOSTNAME": "integration-test-default-log"
        },
        "intake": {
          "enabled": false
        },
        "name": "adp-logging-default-path",
        "procedure": [
          {
            "assertion": "log_contains",
            "pattern": "Initial configuration received.",
            "regex": false,
            "stream": "both",
            "timeout": "30s"
          },
          {
            "assertion": "file_contains",
            "path": "/var/log/datadog/agent-data-plane.log",
            "pattern": "DATAPLANE",
            "regex": false,
            "timeout": "30s"
          }
        ],
        "runtimes": [
          "linux"
        ],
        "timeout": "120s"
      },
      "steps": {
        "single_assertions": 2,
        "parallel_blocks": 0,
        "parallel_assertions": 0,
        "actions": 0,
        "by_kind": {
          "file_contains": 1,
          "log_contains": 1
        }
      },
      "ignored_fields": []
    },
