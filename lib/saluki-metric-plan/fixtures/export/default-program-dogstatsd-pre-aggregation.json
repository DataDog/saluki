  },
  "nodes": [
    {"id": "dsd_enrich", "op": "dogstatsd_mapper", "params": {"profiles": [{"name": "checkout", "prefix": "raw.", "mappings": [{"match": "raw.requests.*", "match_type": "wildcard", "name": "mapped.requests", "tags": [{"name": "route", "value": "$1"}]}]}], "cache_size": 1000, "string_interner_bytes": 65536}},
    {"id": "dsd_prefix_filter_blocklist_namespace_prefix", "op": "namespace_prefix", "params": {"namespace": "tenant", "exclusions": ["internal.", "system."]}},
    {"id": "dsd_prefix_filter_blocklist", "op": "split", "params": {"predicate": {"not": {"intake_name": {"eq": "tenant.raw.blocked"}}}}},
    {"id": "dsd_prefix_filter_blocklist_false", "op": "drop"},
    {"id": "dsd_no_agg_split", "op": "timestamp_split", "params": {"window": "10s"}},
    {"id": "dsd_tag_filterlist", "op": "tag_projection", "params": {"rules": [{"metric_name": "tenant.checkout.latency", "action": "exclude", "tags": ["user_id"]}], "value_rules": [{"metric_prefix": "tenant.checkout.", "tag_name": "env", "values": ["prod", "staging"], "on_miss": "replace", "replacement": "other"}], "cache_capacity": 100000}},
    {"id": "dsd_agg", "op": "aggregate", "params": {"window": "10s", "flush_interval": "15s", "context_limit": 1000000, "counter_expiry": "5m", "flush_open_windows": false, "histogram_aggregates": ["max", "median", "avg", "count"], "histogram_percentiles": [95], "copy_to_distribution": false, "copy_to_distribution_prefix": ""}}
  ],
  "edges": [
    {"from": "input.metrics", "to": "dsd_enrich.in"},
    {"from": "dsd_enrich.out", "to": "dsd_prefix_filter_blocklist_namespace_prefix.in"},
