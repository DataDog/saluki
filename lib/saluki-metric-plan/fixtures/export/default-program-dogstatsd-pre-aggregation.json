    {"from": "dsd_prefix_filter_blocklist.false", "to": "dsd_prefix_filter_blocklist_false.in"},
    {"from": "dsd_prefix_filter_blocklist.true", "to": "dsd_no_agg_split.in"},
    {"from": "dsd_no_agg_split.default", "to": "dsd_tag_filterlist.in"},
    {"from": "dsd_tag_filterlist.out", "to": "dsd_agg.in"},
    {"from": "dsd_agg.out", "to": "exit.aggregated"},
    {"from": "dsd_no_agg_split.passthrough", "to": "exit.passthrough"}
  ]
