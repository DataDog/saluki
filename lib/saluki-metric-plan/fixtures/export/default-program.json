{
  "ir_version": 1,
  "nodes": [
    {"id": "dsd_enrich", "op": "dogstatsd_mapper", "params": {"profiles": [{"name": "checkout", "prefix": "raw.", "mappings": [{"match": "raw.requests.*", "match_type": "wildcard", "name": "mapped.requests", "tags": [{"name": "route", "value": "$1"}]}]}], "cache_size": 1000, "string_interner_bytes": 65536}},
    {"id": "dsd_prefix_filter_namespace_prefix", "op": "namespace_prefix", "params": {"namespace": "tenant", "exclusions": ["internal.", "system."]}},
    {"id": "dsd_prefix_filter", "op": "split", "params": {"predicate": {"not": {"intake_name": {"eq": "tenant.raw.blocked"}}}}},
    {"id": "dsd_prefix_filter_false", "op": "drop"},
    {"id": "dsd_no_agg_split", "op": "timestamp_split", "params": {"window": "10s"}},
    {"id": "dsd_tag_filterlist", "op": "tag_projection", "params": {"rules": [{"metric_name": "tenant.checkout.latency", "action": "exclude", "tags": ["user_id"]}], "value_rules": [{"metric_prefix": "tenant.checkout.", "tag_name": "env", "values": ["prod", "staging"], "on_miss": "replace", "replacement": "other"}], "cache_capacity": 100000}},
    {"id": "dsd_agg", "op": "aggregate", "params": {"window": "10s", "flush_interval": "15s", "context_limit": 1000000, "counter_expiry": "5m", "flush_open_windows": false, "histogram_aggregates": ["max", "median", "avg", "count"], "histogram_percentiles": [95], "copy_to_distribution": false, "copy_to_distribution_prefix": ""}},
    {"id": "dsd_post_agg_filter_in", "op": "merge", "params": {"inputs": 2}},
    {"id": "dsd_post_agg_filter", "op": "split", "params": {"predicate": {"not": {"all": [{"kind_in": ["counter", "rate", "gauge", "set"]}, {"intake_name": {"eq": "tenant.checkout.latency.max"}}]}}}},
    {"id": "dsd_post_agg_filter_false", "op": "drop"},
    {"id": "dsd_post_agg_filter_fanout", "op": "tee", "params": {"ports": 2}},
    {"id": "dsd_post_agg_filter_fanout_0", "op": "emit", "params": {"output": "dsd_client_telemetry"}},
    {"id": "metrics_in", "op": "merge", "params": {"inputs": 5}},
    {"id": "metrics_host_enrichment", "op": "host_enrichment"},
    {"id": "metrics", "op": "host_tags", "params": {"tags": {"config": "host.tags"}, "deadline": {"config": "host.tags_deadline"}}},
    {"id": "metrics_fanout", "op": "tee", "params": {"ports": 5}},
    {"id": "metrics_fanout_0", "op": "emit", "params": {"output": "dd_metrics_encode"}},
    {"id": "metrics_routing_filter_0", "op": "split", "params": {"predicate": {"any": [{"intake_name": {"eq": "checkout.requests"}}, {"intake_name": {"prefix": "checkout."}}]}}},
    {"id": "metrics_routing_filter_0_true", "op": "emit", "params": {"output": "metrics_routing_encode_0"}},
    {"id": "metrics_routing_filter_0_false", "op": "drop"},
    {"id": "metrics_routing_filter_1", "op": "split", "params": {"predicate": {"intake_name": {"prefix": "catalog."}}}},
    {"id": "metrics_routing_filter_1_true", "op": "emit", "params": {"output": "metrics_routing_encode_1"}},
    {"id": "metrics_routing_filter_1_false", "op": "drop"},
    {"id": "mrf_metrics_gateway", "op": "split", "params": {"predicate": {"all": [{"flag": {"config": "multi_region_failover.enabled"}}, {"flag": {"config": "multi_region_failover.metric_mirroring.enabled"}}]}}},
    {"id": "mrf_metrics_gateway_true", "op": "emit", "params": {"output": "mrf_metrics_encode"}},
    {"id": "mrf_metrics_gateway_false", "op": "drop"},
    {"id": "af_metrics_gateway", "op": "split", "params": {"predicate": {"all": [{"kind_in": ["counter", "rate", "gauge", "set"]}, {"flag": {"config": "autoscaling_failover.enabled"}}, {"name": {"eq": "requests.count"}}]}}},
    {"id": "af_metrics_gateway_true", "op": "emit", "params": {"output": "af_metrics_encode"}},
    {"id": "af_metrics_gateway_false", "op": "drop"}
  ],
  "edges": [
    {"from": "input.dogstatsd", "to": "dsd_enrich.in"},
    {"from": "dsd_enrich.out", "to": "dsd_prefix_filter_namespace_prefix.in"},
    {"from": "dsd_prefix_filter_namespace_prefix.out", "to": "dsd_prefix_filter.in"},
    {"from": "dsd_prefix_filter.false", "to": "dsd_prefix_filter_false.in"},
    {"from": "dsd_prefix_filter.true", "to": "dsd_no_agg_split.in"},
    {"from": "dsd_no_agg_split.default", "to": "dsd_tag_filterlist.in"},
    {"from": "dsd_tag_filterlist.out", "to": "dsd_agg.in"},
    {"from": "dsd_agg.out", "to": "dsd_post_agg_filter_in.0"},
    {"from": "dsd_no_agg_split.passthrough", "to": "dsd_post_agg_filter_in.1"},
    {"from": "dsd_post_agg_filter_in.out", "to": "dsd_post_agg_filter.in"},
    {"from": "dsd_post_agg_filter.false", "to": "dsd_post_agg_filter_false.in"},
    {"from": "dsd_post_agg_filter.true", "to": "dsd_post_agg_filter_fanout.in"},
    {"from": "dsd_post_agg_filter_fanout.0", "to": "dsd_post_agg_filter_fanout_0.in"},
    {"from": "dsd_post_agg_filter_fanout.1", "to": "metrics_in.0"},
    {"from": "input.otlp", "to": "metrics_in.1"},
    {"from": "input.checks", "to": "metrics_in.2"},
    {"from": "input.liveness", "to": "metrics_in.3"},
    {"from": "input.trace_sampler", "to": "metrics_in.4"},
    {"from": "metrics_in.out", "to": "metrics_host_enrichment.in"},
    {"from": "metrics_host_enrichment.out", "to": "metrics.in"},
    {"from": "metrics.out", "to": "metrics_fanout.in"},
    {"from": "metrics_fanout.0", "to": "metrics_fanout_0.in"},
    {"from": "metrics_fanout.1", "to": "metrics_routing_filter_0.in"},
    {"from": "metrics_routing_filter_0.true", "to": "metrics_routing_filter_0_true.in"},
    {"from": "metrics_routing_filter_0.false", "to": "metrics_routing_filter_0_false.in"},
    {"from": "metrics_fanout.2", "to": "metrics_routing_filter_1.in"},
    {"from": "metrics_routing_filter_1.true", "to": "metrics_routing_filter_1_true.in"},
    {"from": "metrics_routing_filter_1.false", "to": "metrics_routing_filter_1_false.in"},
    {"from": "metrics_fanout.3", "to": "mrf_metrics_gateway.in"},
    {"from": "mrf_metrics_gateway.true", "to": "mrf_metrics_gateway_true.in"},
    {"from": "mrf_metrics_gateway.false", "to": "mrf_metrics_gateway_false.in"},
    {"from": "metrics_fanout.4", "to": "af_metrics_gateway.in"},
    {"from": "af_metrics_gateway.true", "to": "af_metrics_gateway_true.in"},
    {"from": "af_metrics_gateway.false", "to": "af_metrics_gateway_false.in"}
  ]
}
