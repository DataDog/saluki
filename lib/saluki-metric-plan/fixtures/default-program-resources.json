{
  "outputs": [
    {"id": "dsd_client_telemetry", "accepts": {"kinds": "all", "timestamps": "mixed"},
     "recipients": [], "delivery": "native"},
    {"id": "dd_metrics_encode", "accepts": {"kinds": "all", "timestamps": "mixed"},
     "recipients": ["dd_out/primary/0"], "delivery": "native",
     "binding": {"host": "dd_out", "selector": {"role": "main"},
                 "encoder": {"series": "v2", "flush_timeout": "2s"},
                 "telemetry": "dd_metrics_encode"}},
    {"id": "metrics_routing_encode_0", "accepts": {"kinds": "all", "timestamps": "mixed"},
     "recipients": ["dd_out/additional_0/0"], "delivery": "native",
     "binding": {"host": "dd_out",
                 "selector": {"group": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
                 "encoder": {"series": "v2", "flush_timeout": "2s"},
                 "telemetry": "metrics_routing_encode_0"}},
    {"id": "metrics_routing_encode_1", "accepts": {"kinds": "all", "timestamps": "mixed"},
     "recipients": ["dd_out/additional_1/0", "dd_out/additional_1/1"], "delivery": "native",
     "binding": {"host": "dd_out",
                 "selector": {"group": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
                 "encoder": {"series": "v2", "flush_timeout": "2s"},
                 "telemetry": "metrics_routing_encode_1"}},
    {"id": "mrf_metrics_encode", "accepts": {"kinds": "all", "timestamps": "mixed"},
     "recipients": ["mrf_dd_out/primary/0"], "delivery": "native",
     "binding": {"host": "mrf_dd_out", "selector": {"role": "multi_region_failover"},
                 "encoder": {"series": "v2", "flush_timeout": "2s"},
                 "telemetry": "mrf_metrics_encode"}},
    {"id": "af_metrics_encode", "accepts": {"kinds": ["counter", "rate", "gauge", "set"], "timestamps": "mixed"},
     "recipients": ["cluster_agent_out/primary/0"], "delivery": "native",
     "binding": {"host": "cluster_agent_out", "selector": {"role": "autoscaling_failover"},
                 "encoder": {"series": "v2", "flush_timeout": "2s"},
                 "telemetry": "af_metrics_encode"}}
  ],
  "resources": {
    "hosts": [
      {"host": "dd_out", "settings": {"request_timeout": "20s", "endpoint_concurrency": 1}},
      {"host": "mrf_dd_out", "settings": {"request_timeout": "20s", "endpoint_concurrency": 1}},
      {"host": "cluster_agent_out", "settings": {"request_timeout": "20s", "endpoint_concurrency": 1}}
    ],
    "recipients": [
      {"id": "dd_out/primary/0", "host": "dd_out", "endpoint": "https://app.datadoghq.com",
       "credential": "native:api_key", "classes": "all",
       "protocol": {"kind": "datadog_intake", "v3": {"series": false, "sketches": false}}},
      {"id": "dd_out/additional_0/0", "host": "dd_out", "endpoint": "https://group0.example.com",
       "credential": "native:additional/0123456789abcdef/0", "classes": "all",
       "protocol": {"kind": "datadog_intake", "v3": {"series": false, "sketches": false}}},
      {"id": "dd_out/additional_1/0", "host": "dd_out", "endpoint": "https://group1.example.com",
       "credential": "native:additional/fedcba9876543210/0", "classes": "all",
       "protocol": {"kind": "datadog_intake", "v3": {"series": false, "sketches": false}}},
      {"id": "dd_out/additional_1/1", "host": "dd_out", "endpoint": "https://group1.example.com",
       "credential": "native:additional/fedcba9876543210/1", "classes": "all",
       "protocol": {"kind": "datadog_intake", "v3": {"series": false, "sketches": false}}},
      {"id": "mrf_dd_out/primary/0", "host": "mrf_dd_out", "endpoint": "https://app.datadoghq.eu",
       "credential": "native:multi_region_failover.api_key", "classes": "all",
       "protocol": {"kind": "datadog_intake", "v3": {"series": false, "sketches": false}}},
      {"id": "cluster_agent_out/primary/0", "host": "cluster_agent_out",
       "endpoint": "https://datadog-cluster-agent.default.svc:5005", "credential": "native:cluster_agent.auth_token",
       "classes": "metrics_only", "protocol": {"kind": "cluster_agent"}}
    ]
  }
}
