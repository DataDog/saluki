# DogStatsD over UDP only (`SCALING_TRANSPORT=udp`, `run-regime.sh`): `compose.yaml` sets `DD_DOGSTATSD_PORT` from
# `DOGSTATSD_PORT`, which the script sets to 8125 for this transport. UDP is the transport whose socket drops the kernel
# counts (`RcvbufErrors` in the network namespace's `/proc/net/snmp`); a Unix datagram sender blocks instead.
DD_DOGSTATSD_SOCKET=
# ADP binds UDP on 127.0.0.1 unless non-local traffic is on; lading sends from its own container.
DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true
