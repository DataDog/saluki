diff --git a/lib/saluki-core/src/observability/flow_trace.rs b/lib/saluki-core/src/observability/flow_trace.rs
new file mode 100644
index 0000000000..c423fa09e1
--- /dev/null
+++ b/lib/saluki-core/src/observability/flow_trace.rs
@@ -0,0 +1,217 @@
+//! An experiment: a fine-grained trace of where the metrics path waits, for investigating admission stalls.
+//!
+//! Off unless `SALUKI_EXPERIMENT_TRACE` names a file. When on, each dispatcher output counts the time its sends spend
+//! waiting (for the admission point's lock and for room downstream), each region host publishes its input queue's
+//! depth, and the hosts of regions that drain record each drain; a background thread writes every 100 ms, to the file,
+//! the counters' changes since its last write, the queue depths, and the drains that ended, all stamped with the Unix
+//! time in milliseconds, so that they can be lined up with measurements taken outside the process. The experiment is
+//! not a supported setting: it costs two clock reads per send and a file write every 100 ms.
+//!
+//! Lines are space-separated:
+//!
+//! - `w <unix_ms> <name> <wait_us> <sends> <items>`: an output's waiting since the last line for it (only outputs that
+//!   sent);
+//! - `q <unix_ms> <name> <batches>`: a region's input queue depth, now;
+//! - `d <start_unix_ms> <name> <duration_us> <steps> <dispatch_wait_us> <events_out> <queued_at_start> <queued_at_end>`:
+//!   a drain that ended.
+
+use std::{
+    fs::File,
+    io::{BufWriter, Write as _},
+    sync::{
+        atomic::{AtomicU64, Ordering::Relaxed},
+        Arc, Mutex, OnceLock,
+    },
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+/// The environment variable that turns the trace on, naming the file it writes.
+pub const FLOW_TRACE_ENV: &str = "SALUKI_EXPERIMENT_TRACE";
+
+const INTERVAL: Duration = Duration::from_millis(100);
+
+/// The waiting of one dispatcher output.
+#[derive(Debug, Default)]
+pub struct WaitCounter {
+    name: String,
+    wait_us: AtomicU64,
+    sends: AtomicU64,
+    items: AtomicU64,
+}
+
+impl WaitCounter {
+    /// Counts one send of `items` items that waited `waited`.
+    pub fn record(&self, waited: Duration, items: usize) {
+        self.wait_us.fetch_add(waited.as_micros() as u64, Relaxed);
+        self.sends.fetch_add(1, Relaxed);
+        self.items.fetch_add(items as u64, Relaxed);
+    }
+}
+
+/// The depth of one region's input queue.
+#[derive(Debug, Default)]
+pub struct QueueGauge {
+    name: String,
+    batches: AtomicU64,
+}
+
+impl QueueGauge {
+    /// Sets the depth.
+    pub fn set(&self, batches: usize) {
+        self.batches.store(batches as u64, Relaxed);
+    }
+
+    /// Returns the depth last set.
+    pub fn get(&self) -> usize {
+        self.batches.load(Relaxed) as usize
+    }
+
+    /// Returns the gauge's name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+/// A drain in progress in a region host.
+#[derive(Debug)]
+pub struct Drain {
+    started: Instant,
+    started_unix_ms: u64,
+    steps: u64,
+    dispatch_wait: Duration,
+    events_out: u64,
+    queued_at_start: usize,
+}
+
+impl Drain {
+    /// Starts a drain, with `queued` batches waiting at the host's input.
+    pub fn start(queued: usize) -> Self {
+        Self {
+            started: Instant::now(),
+            started_unix_ms: unix_ms(),
+            steps: 0,
+            dispatch_wait: Duration::ZERO,
+            events_out: 0,
+            queued_at_start: queued,
+        }
+    }
+
+    /// Counts one step of the drain, whose output took `dispatch_wait` to send and held `events` events.
+    pub fn step(&mut self, dispatch_wait: Duration, events: u64) {
+        self.steps += 1;
+        self.dispatch_wait += dispatch_wait;
+        self.events_out += events;
+    }
+
+    /// Ends the drain of the region `name`, with `queued` batches waiting at the host's input, and records it.
+    pub fn end(self, name: &str, queued: usize) {
+        if let Some(trace) = trace() {
+            let line = format!(
+                "d {} {} {} {} {} {} {} {}",
+                self.started_unix_ms,
+                name,
+                self.started.elapsed().as_micros(),
+                self.steps,
+                self.dispatch_wait.as_micros(),
+                self.events_out,
+                self.queued_at_start,
+                queued
+            );
+            trace.drains.lock().expect("not poisoned").push(line);
+        }
+    }
+}
+
+struct Trace {
+    counters: Mutex<Vec<Arc<WaitCounter>>>,
+    gauges: Mutex<Vec<Arc<QueueGauge>>>,
+    drains: Mutex<Vec<String>>,
+}
+
+fn trace() -> Option<&'static Trace> {
+    static TRACE: OnceLock<Option<&'static Trace>> = OnceLock::new();
+    *TRACE.get_or_init(|| {
+        let path = std::env::var_os(FLOW_TRACE_ENV)?;
+        let file = File::create(&path).ok()?;
+        let trace: &'static Trace = Box::leak(Box::new(Trace {
+            counters: Mutex::new(Vec::new()),
+            gauges: Mutex::new(Vec::new()),
+            drains: Mutex::new(Vec::new()),
+        }));
+        std::thread::Builder::new()
+            .name("flow-trace".to_string())
+            .spawn(move || write_forever(trace, BufWriter::new(file)))
+            .ok()?;
+        Some(trace)
+    })
+}
+
+/// Returns `true` if the trace is on.
+pub fn enabled() -> bool {
+    trace().is_some()
+}
+
+/// Returns a wait counter named `name`, registered with the trace, if the trace is on.
+pub fn wait_counter(name: String) -> Option<Arc<WaitCounter>> {
+    let trace = trace()?;
+    let counter = Arc::new(WaitCounter {
+        name,
+        ..WaitCounter::default()
+    });
+    trace.counters.lock().expect("not poisoned").push(Arc::clone(&counter));
+    Some(counter)
+}
+
+/// Returns a queue gauge named `name`, registered with the trace, if the trace is on.
+pub fn queue_gauge(name: String) -> Option<Arc<QueueGauge>> {
+    let trace = trace()?;
+    let gauge = Arc::new(QueueGauge {
+        name,
+        ..QueueGauge::default()
+    });
+    trace.gauges.lock().expect("not poisoned").push(Arc::clone(&gauge));
+    Some(gauge)
+}
+
+fn unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| since.as_millis() as u64)
+}
+
+fn write_forever(trace: &'static Trace, mut out: BufWriter<File>) {
+    // The last totals written for each counter, by its position in the registry, which only grows.
+    let mut last: Vec<(u64, u64, u64)> = Vec::new();
+    loop {
+        std::thread::sleep(INTERVAL);
+        let now = unix_ms();
+        let counters = trace.counters.lock().expect("not poisoned").clone();
+        last.resize(counters.len(), (0, 0, 0));
+        for (counter, last) in counters.iter().zip(last.iter_mut()) {
+            let totals = (
+                counter.wait_us.load(Relaxed),
+                counter.sends.load(Relaxed),
+                counter.items.load(Relaxed),
+            );
+            if totals.1 != last.1 {
+                let _ = writeln!(
+                    out,
+                    "w {} {} {} {} {}",
+                    now,
+                    counter.name,
+                    totals.0 - last.0,
+                    totals.1 - last.1,
+                    totals.2 - last.2
+                );
+            }
+            *last = totals;
+        }
+        for gauge in trace.gauges.lock().expect("not poisoned").iter() {
+            let _ = writeln!(out, "q {} {} {}", now, gauge.name, gauge.batches.load(Relaxed));
+        }
+        for line in std::mem::take(&mut *trace.drains.lock().expect("not poisoned")) {
+            let _ = writeln!(out, "{}", line);
+        }
+        let _ = out.flush();
+    }
+}
