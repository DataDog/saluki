{
  "probes": [
    {
      "id": "metrics-protobuf",
      "description": "A protobuf metrics request. The request accepts gzip, and neither receiver compresses its answer.",
      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "application/x-protobuf",
          "Accept-Encoding": "gzip"
        },
        "body": "metrics-protobuf"
      },
      "expect": {
        "status": 200,
        "headers": {
          "Content-Type": "application/x-protobuf",
          "Content-Encoding": null
        },
        "body": "\n\u0000"
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-response-format",
          "issue": 3482,
          "reason": "ADP answers a success with the plain text `OK`. The OTLP specification asks for a serialized response message in the content type of the request, which is what the Agent sends.",
          "got": {
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            },
            "body": "OK"
          }
        }
      ]
    },
