    {
      "id": "metrics-json",
      "description": "A JSON metrics request.",
      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "metrics-json"
      },
      "expect": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"partialSuccess\":{}}"
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-content-type",
          "issue": 3480,
          "reason": "ADP ignores the content type and decodes every body as protobuf, so it fails a JSON body with status 500. The Agent decodes the JSON.",
          "got": {
            "status": 500,
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            },
            "body": "Internal processing error"
          }
        }
      ]
    },
