    {
      "id": "metrics-gzip",
      "description": "A protobuf metrics request with a gzip body and the matching `Content-Encoding`.",
      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "application/x-protobuf",
          "Content-Encoding": "gzip"
        },
        "body": "metrics-protobuf",
        "encode": "gzip"
      },
      "expect": {
        "status": 200,
        "headers": {
          "Content-Type": "application/x-protobuf"
        },
        "body": "\n\u0000"
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-content-encoding",
          "issue": 3481,
          "reason": "ADP ignores `Content-Encoding` and decodes the compressed body as protobuf, so it fails with status 500. The Agent decompresses the body.",
          "got": {
            "status": 500,
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            },
            "body": "Internal processing error"
          }
        }
      ]
    },
    {
      "id": "metrics-br",
      "description": "A protobuf metrics request that names an encoding that no receiver supports. The body is not compressed.",
      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "application/x-protobuf",
          "Content-Encoding": "br"
        },
        "body": "metrics-protobuf"
      },
      "expect": {
        "status": 400,
        "headers": {
          "Content-Type": "application/x-protobuf"
        },
        "body_contains": "unsupported Content-Encoding: br"
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-content-encoding",
          "issue": 3481,
          "reason": "ADP ignores `Content-Encoding`, so it accepts the body. The Agent refuses an encoding that it does not know, with status 400.",
          "got": {
            "status": 200,
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            },
            "body": "OK"
          }
        }
      ]
    },
    {
      "id": "metrics-text-plain",
      "description": "A protobuf metrics request with the content type `text/plain`.",
      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "metrics-protobuf"
      },
      "expect": {
        "status": 415,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "415 unsupported media type, supported: [application/json, application/x-protobuf]"
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-content-type",
          "issue": 3480,
          "reason": "ADP ignores the content type, so it accepts the body. The Agent refuses a content type that is not JSON or protobuf, with status 415.",
          "got": {
            "status": 200,
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            },
            "body": "OK"
          }
        }
      ]
    },
