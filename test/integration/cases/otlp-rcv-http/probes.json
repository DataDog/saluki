      "request": {
        "method": "POST",
        "path": "/v1/metrics",
        "headers": {
          "Content-Type": "application/x-protobuf"
        },
        "body": "garbage"
      },
      "expect": {
        "status": 400,
        "headers": {
          "Content-Type": "application/x-protobuf"
        }
      },
      "known": [
        {
          "side": "adp",
          "gap": "gap/otlp-http-response-format",
          "issue": 3482,
          "reason": "ADP answers a body that it cannot decode with status 500 and plain text. The Agent answers with status 400 and a `google.rpc.Status` message, as the OTLP specification says.",
          "got": {
            "status": 500,
            "headers": {
              "Content-Type": "text/plain; charset=utf-8"
            }
          }
        }
      ]
    },
