{# ADP configuration for metric aggregation interval prefix-scaling experiments.

   Rendered by generate_experiments.py with the experiment's `variables` in scope as `exp_vars`.
   The generated copies under full/cases/ are outputs: edit this template, then run
   `make generate-smp-experiments`. #}
{% if exp_vars.rule_mode == "none" %}
metric_aggregation_intervals: []
{% elif exp_vars.rule_mode == "per_metric" %}
metric_aggregation_intervals:
{% for metric_name in lading_names(exp_vars.metric_prefix, exp_vars.rule_metric_first, exp_vars.rule_metrics) %}
  - metric_prefix: {{ metric_name }}
    interval_seconds: {{ exp_vars.interval_seconds }}
{% endfor %}
{% else %}
{{ fail_unknown_rule_mode }}
{% endif %}
