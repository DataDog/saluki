@@ -775,6 +775,15 @@ func (s *anomalyScorer) Advance(dataTime int64) {
 	for sec := start; sec <= dataTime; sec++ {
 		ewma := s.advanceSecond(sec)
 		level := s.advanceRawLevel(ewma)
+		// Diagnostic-only: record the raw severity on the bucket just emitted for
+		// this second. The bucket appended by advanceSecond is always the last
+		// entry (the cap keeps the newest buckets), so index len-1 is this second.
+		if n := len(s.buckets); n > 0 && s.buckets[n-1].Second == sec {
+			s.buckets[n-1].RawLevel = level.String()
+			// Delivered equals raw because the testbench scorer runs with cooldown 0;
+			// recording it here keeps the parity comparator from recomputing it.
+			s.buckets[n-1].DeliveredLevel = level.String()
+		}
