 // ScenarioInfo describes an available scenario.
@@ -1190,6 +1195,29 @@ func (tb *Bench) RunHeadless(scenario, outputPath string, verbose bool) error {
 		fmt.Printf("Observer output written to %s\n", outputPath)
 	}
 
+	if tb.config.ScoreStateOutput != "" {
+		if err := tb.WriteScoreState(tb.config.ScoreStateOutput); err != nil {
+			return fmt.Errorf("writing score-state output: %w", err)
+		}
+		fmt.Printf("Score state written to %s\n", tb.config.ScoreStateOutput)
+	}
+
+	return nil
+}
+
+// WriteScoreState writes the scorer's accumulated per-second score state to path as JSON.
+// This is diagnostic-only parity instrumentation: it reads state that the scorer already
+// maintains (ScoreState) and does not alter any analytical behavior.
+func (tb *Bench) WriteScoreState(path string) error {
+	sv := tb.debug.StateView()
+	state := sv.ScoreState()
+	data, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshalling score state: %w", err)
+	}
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		return fmt.Errorf("writing %s: %w", path, err)
+	}
 	return nil
 }
 
