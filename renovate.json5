// Renovate configuration for the Saluki repo.
//
// This file is JSON5. Can be validated with:
//     npx --yes --package renovate -- renovate-config-validator renovate.json5
//
// The configuration below is designed to spam us with fewer PRs:
//
//   - Updates land in a single weekly window instead of continuously.
//   - Non-major updates collapse into one combined PR.
//   - Brand-new releases soak for a week before Renovate proposes them, which
//     filters out same-week re-bumps and gives upstream maintainers time to
//     yank broken releases.
//   - Hard caps prevent surprise floods from a busy ecosystem week.
//
// Security advisories are explicitly exempted from all of the above and open
// dedicated PRs immediately. See the `vulnerabilityAlerts` block.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Presets are bundles of config maintained by the Renovate project.
  extends: [
    "config:recommended",
    // Collapse all non-major updates (patch + minor) across every ecosystem
    // into a single PR per scheduled run.
    "group:allNonMajor",

    // Restrict Renovate to creating branches to weekly.
    "schedule:weekly",
  ],

  // Mark Renovate PRs as automated so various checks that only apply to
  // non-automated changes will skip running for dependency update PRs.
  labels: [
    "automated",
  ],

  // Maximum number of Renovate-authored PRs that may be open at once.
  prConcurrentLimit: 5,

  // Maximum number of new PRs Renovate may create per hour.
  prHourlyLimit: 2,

  // Wait this long after a new version is published before Renovate will
  // propose updating to it.
  minimumReleaseAge: "7 days",

  // Renovate has a separate code path for vulnerability fixes. When a
  // dependency in the repo has a known advisory (from GitHub's security
  // advisory feed and, with the option below, from OSV.dev) and a fixed
  // version is available, Renovate creates a dedicated PR that bypasses:
  //
  //   - `schedule` (opens immediately, not just on Monday)
  //   - `minimumReleaseAge` (no 7-day soak)
  //   - `prConcurrentLimit` and `prHourlyLimit` (does not count against caps)
  //   - grouping (gets its own focused PR rather than being bundled in the
  //     weekly non-major group)
  osvVulnerabilityAlerts: true,

  // Versions that no built-in manager reads: the development and CI tools that
  // the Makefile and the Windows CI scripts pin.
  customManagers: [
    // Cargo tools that `make cargo-install-<tool>` installs. The variable
    // suffix is the crate name.
    {
      customType: "regex",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "export CARGO_TOOL_VERSION_(?<depName>[A-Za-z0-9_-]+) \\?= (?<currentValue>\\S+)",
      ],
      datasourceTemplate: "crate",
    },
    // The Windows unit test job doesn't use the Makefile, so it pins
    // cargo-nextest again. Renovate groups this with the Makefile pin.
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.gitlab/windows\\.yml$/",
        "/^ci/tooling/windows-unit-tests\\.ps1$/",
      ],
      matchStrings: [
        "CARGO_NEXTEST_VERSION\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "cargo-nextest",
      datasourceTemplate: "crate",
    },
    // Other pins, marked by a `# renovate: datasource=<datasource>
    // depName=<name>` comment on the line above.
    {
      customType: "regex",
      managerFilePatterns: [
        "/^Makefile$/",
      ],
      matchStrings: [
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n[^\\n]*?=\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],

  // Package-manager-specific rules.
  packageRules: [
    // Development and CI tools get their own PR, so that a broken tool release
    // doesn't hold back the weekly dependency PR.
    {
      matchManagers: [
        "custom.regex",
      ],
      groupName: "development and CI tools",
    },
    // A Cargo tool pin is one exact version. The `crate` datasource uses Cargo
    // versioning by default, which reads a bare `0.9.152` as the range
    // `^0.9.152` and doesn't propose newer versions inside that range.
    {
      matchManagers: [
        "custom.regex",
      ],
      matchDatasources: [
        "crate",
      ],
      versioning: "semver",
    },
    // The Windows build installs cargo-auditable from a release zip that is
    // pinned by SHA256, which Renovate can't update.
    {
      matchManagers: [
        "custom.regex",
      ],
      matchPackageNames: [
        "cargo-auditable",
      ],
      prBodyNotes: [
        "**cargo-auditable** — Also update `$CargoAuditableVersion` and `$CargoAuditableSha256` in `ci/tooling/windows-build-adp.ps1`.",
      ],
    },
    // A new version of a tool that the build CI image installs (`make
    // cargo-preinstall`) is built from source in each CI job until the image
    // is regenerated.
    {
      matchManagers: [
        "custom.regex",
      ],
      matchDatasources: [
        "crate",
      ],
      prBodyNotes: [
        "**Cargo tool update** — After merging, run the `generate-build-ci-image` and `promote-build-ci-image` jobs, so that CI jobs stop building the new versions from source.",
      ],
    },
    // Use Cargo's semver interpretation for all Cargo dependencies. Cargo
    // treats `^0.x` as `>=0.x.0, <0.x+1.0`, so a bump from `0.9` to `0.10`
    // is a breaking (major) change. Without this, Renovate uses standard
    // semver where such a bump is classified as "minor" and incorrectly
    // lands in the non-major group PR — which cannot fix compilation errors
    // caused by removed features or API changes.
    {
      matchManagers: [
        "cargo",
      ],
      versioning: "cargo",
    },
    // Cargo pre-1.0 breaking updates: `0.x` → `0.y` is a breaking change in
    // Cargo's semver (`^0.9` covers `>=0.9.0, <0.10.0`), but Renovate still
    // assigns `updateType: "minor"` because the major version digit (`0`) does
    // not change. That means `group:allNonMajor` captures these bumps in the
    // weekly batch PR, where Renovate cannot fix compilation errors from
    // removed features or API changes. Override `groupName` so they land in a
    // dedicated PR that clearly signals manual review is required.
    {
      matchManagers: [
        "cargo",
      ],
      matchCurrentVersion: "/^0\\.[0-9]/",
      matchUpdateTypes: [
        "minor",
      ],
      groupName: "cargo pre-1.0 breaking updates",
      prBodyNotes: [
        "**Cargo breaking update (pre-v1.0)** — `0.x` → `0.y` is a breaking change in Cargo's semver. Before merging, verify the workspace compiles and check upstream release notes for removed features or API changes.",
      ],
    },
    // schemars/typify/prettyplease are stuck in a dependency deadlock tracked
    // in our #2289 and at https://github.com/oxidecomputer/typify/issues/886
    {
      matchManagers: [
        "cargo",
      ],
      matchPackageNames: [
        "schemars",
        "schemars_derive",
        "typify",
        "typify-impl",
        "typify-macro",
        "prettyplease",
      ],
      groupName: "blocked schema/codegen dependencies",
      dependencyDashboardApproval: true,
    },
    // Warn reviewers that genuine Cargo major updates (1.x → 2.0, etc.) may
    // also require manual fixes for removed features or API changes.
    {
      matchManagers: [
        "cargo",
      ],
      matchUpdateTypes: [
        "major",
      ],
      prBodyNotes: [
        "**Cargo major update** — Before merging, verify the workspace compiles and check upstream release notes for removed features or API changes.",
      ],
    },
    // We deliberately hold the Rust toolchain (rust-toolchain.toml `channel`) well
    // below the latest stable release to preserve broader platform support for
    // consumers on older compilers. Disable Renovate's `rust-toolchain` manager so it
    // stops proposing bumps here; the toolchain version is a manual decision.
    {
      matchManagers: [
        "rust-toolchain",
      ],
      enabled: false,
    },
    // aws-lc-rs selects the AWS-LC FIPS module through its `aws-lc-fips-sys` dependency, and it has only moved to a
    // new FIPS module in a minor release (1.18.0 moved from FIPS 3 to FIPS 4). FIPS builds must stay on a certified
    // module, and the `aws-lc-fips-sys` ban in deny.toml fails CI for an uncertified one. Without this rule, a minor
    // release that moves to the uncertified AWS-LC-FIPS 5 module would fail the weekly non-major group PR. Allow patch
    // releases, and raise this bound by hand after checking which module the next minor release bundles.
    {
      matchManagers: [
        "cargo",
      ],
      matchPackageNames: [
        "aws-lc-rs",
      ],
      allowedVersions: "<1.20",
    },
    // smallvec 1.16 is blocked transitively: serde-saphyr 0.0.29 (via kube-client, used by panoramic)
    // requires `smallvec <1.16`. Renovate cannot generate a Cargo.lock for this bump, and a single failed
    // `cargo update` leaves the entire weekly non-major group PR with an empty diff.
    // Remove once serde-saphyr/kube accept smallvec 1.16.
    {
      matchManagers: [
        "cargo",
      ],
      matchPackageNames: [
        "smallvec",
      ],
      allowedVersions: "<1.16",
    },
  ],
}
